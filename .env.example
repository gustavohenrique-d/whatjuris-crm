# Banco — Supabase (senha URL-encodada: @ vira %40)
# Use o Pooler (Supavisor, porta 6543, com ?pgbouncer=true). O host direto
# db.<ref>.supabase.co pode não resolver por DNS em algumas redes.
DATABASE_URL=

# NextAuth (módulo 2) — NEXTAUTH_URL deve casar com a porta do dev server
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# E-mail (módulo 2) — sem RESEND_API_KEY, o link de convite/reset vai ao console em dev
RESEND_API_KEY=
EMAIL_FROM=

# Google Calendar (opcional — sem isso a sincronização é ignorada)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# WhatsApp Business API (Meta for Developers) — módulos 8/9
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App Secret da Meta — valida o HMAC do webhook (obrigatório em produção)
WHATSAPP_APP_SECRET=

# n8n (módulo 8)
N8N_BASE_URL=
# URL do CRM como o n8n (em Docker) o alcança — no Docker Desktop use host.docker.internal
CRM_CALLBACK_URL=
N8N_API_KEY=

# Webhook interno (o n8n chama o CRM por aqui)
WEBHOOK_SECRET=

# OpenAI (agentes de IA — módulo 9)
OPENAI_API_KEY=

# Consumidos apenas pelo seed
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
ORG_NAME=
