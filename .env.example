# Banco — Supabase (senha URL-encodada: @ vira %40)
# Use o Pooler (Supavisor, porta 6543, com ?pgbouncer=true). O host direto
# db.<ref>.supabase.co pode não resolver por DNS em algumas redes.
DATABASE_URL=

# NextAuth (módulo 2) — NEXTAUTH_URL deve casar com a porta do dev server
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# E-mail (módulo 2) — sem RESEND_API_KEY, o link de convite/reset vai ao console em dev
RESEND_API_KEY=
EMAIL_FROM=

# Google Calendar (opcional — sem isso a sincronização é ignorada)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# WhatsApp Business API (Meta for Developers) — módulos 8/9
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App Secret da Meta — valida o HMAC do webhook (obrigatório em produção)
WHATSAPP_APP_SECRET=
# Rótulo da instância no contrato de saída (fallback: metadata.phone_number_id)
WHATSAPP_INSTANCE_NAME=escritorio-principal
# Versão da Graph API para download de mídia (não hardcodar)
WHATSAPP_GRAPH_API_VERSION=v21.0

# Recepção/normalização de mídia (áudio/imagem) — módulo WhatsApp
AUDIO_TRANSCRIPTION_PROVIDER=openai
VISION_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_AUDIO_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-pro
# Limites de mídia em bytes (25 MiB / 10 MiB)
MAX_AUDIO_BYTES=26214400
MAX_IMAGE_BYTES=10485760
# TTL (segundos) de retenção do registro de idempotência (limpeza futura)
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=604800

# n8n (módulo 8)
N8N_BASE_URL=
# URL do CRM como o n8n (em Docker) o alcança — no Docker Desktop use host.docker.internal
CRM_CALLBACK_URL=
N8N_API_KEY=

# Webhook interno (o n8n chama o CRM por aqui)
WEBHOOK_SECRET=

# Redis — Human Takeover (módulo 2). OPCIONAL: deixe REDIS_URL/REDIS_HOST vazios
# para operar só no PostgreSQL (fonte de verdade). Preencha para ligar o cache.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Human Takeover (módulo 2)
HUMAN_TAKEOVER_KEY_PREFIX=block:v1
HUMAN_TAKEOVER_TTL_SECONDS=3600
OUTBOUND_ORIGIN_TTL_SECONDS=86400

# Buffer de mensagens (módulo 3)
MESSAGE_BUFFER_WAIT_SECONDS=5
MESSAGE_BUFFER_TTL_SECONDS=300
MESSAGE_BUFFER_SEEN_TTL_SECONDS=600
MESSAGE_BUFFER_PROCESSING_TTL_SECONDS=300
MESSAGE_BUFFER_MAX_MESSAGES=50
MESSAGE_BUFFER_MAX_CHARACTERS=30000
MESSAGE_BUFFER_KEY_PREFIX=buffer:v1

# Triagem Jurídica (módulo 4) — OPENAI_API_KEY já definido acima
TRIAGE_LLM_PROVIDER=openai
OPENAI_TRIAGE_MODEL=gpt-4o-mini
TRIAGE_TEMPERATURE=0.2
TRIAGE_MAX_OUTPUT_TOKENS=700
TRIAGE_TIMEOUT_MS=30000
TRIAGE_MAX_RETRIES=2
TRIAGE_MEMORY_WINDOW_MESSAGES=20
TRIAGE_MEMORY_RETENTION_DAYS=90
TRIAGE_MEMORY_TABLE=triage_chat_history
LAW_FIRM_NAME=

# Fragmentação e envio humanizado (módulo 5)
WHATSAPP_MAX_TEXT_CHARS=4000
WHATSAPP_MAX_FRAGMENTS_PER_RESPONSE=10
WHATSAPP_TYPING_DELAY_MIN_MS=2000
WHATSAPP_TYPING_DELAY_MAX_MS=4000
WHATSAPP_TYPING_MS_PER_CHARACTER=30
WHATSAPP_TYPING_INDICATOR_ENABLED=false
WHATSAPP_SEND_TIMEOUT_MS=15000
WHATSAPP_SEND_MAX_RETRIES=3
WHATSAPP_SEND_LOCK_TTL_SECONDS=120

# OpenAI (agentes de IA — módulo 9)
OPENAI_API_KEY=

# Consumidos apenas pelo seed
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
ORG_NAME=
