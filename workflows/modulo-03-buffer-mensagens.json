    {
      "parameters": {
        "jsCode": "// Parseia e ordena o buffer por received_at. Identidade por message_id\n// (nunca por texto). Item invalido (JSON quebrado/sem campos) e' filtrado.\nconst raw = $json.items ?? $json.result ?? [];\nconst items = Array.isArray(raw) ? raw : [];\nconst parsed = items.map(i => {\n  if (typeof i === 'string') { try { return JSON.parse(i); } catch { return null; } }\n  return i;\n}).filter(i => i && typeof i.message_id === 'string' && typeof i.message === 'string' && i.message.trim() !== '');\nparsed.sort((a,b) => {\n  const ta = Date.parse(a.received_at), tb = Date.parse(b.received_at);\n  if (!Number.isNaN(ta) && !Number.isNaN(tb) && ta !== tb) return ta - tb;\n  return String(a.buffered_at ?? '').localeCompare(String(b.buffered_at ?? ''));\n});\nconst messages = parsed.map(i => String(i.message).trim());\nreturn [{ json: {\n  ...$json,\n  buffer_claimed: true,\n  buffered_messages: parsed,\n  buffered_message_ids: parsed.map(i => i.message_id),\n  buffer_count: parsed.length,\n  buffer_total_characters: messages.reduce((t,m) => t + m.length, 0),\n  buffer_started_at: parsed[0]?.received_at ?? null,\n  buffer_ended_at: parsed[parsed.length-1]?.received_at ?? null,\n} }];"
      },
      "id": "ce756fe2-9f3c-4f15-8b14-29fb17fca16f",
      "name": "Code - Parsear e Ordenar Buffer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        352
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.buffer_count }}",
              "rightValue": "={{ Number($env.MESSAGE_BUFFER_MAX_MESSAGES || 50) }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            },
            {
              "leftValue": "={{ $json.buffer_total_characters }}",
              "rightValue": "={{ Number($env.MESSAGE_BUFFER_MAX_CHARACTERS || 30000) }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ]
        },
        "options": {}
      },
