    {
      "parameters": {
        "jsCode": "// Detecta AGENDAMENTO_CONFIRMADO na resposta do Agente Agendador.\n// Regra critica: quando o sinal existe, o texto cru contem JSON e NAO\n// pode ser enviado ao cliente.\nconst ctx = $('Set - Preparar Sessao').item.json;\nconst texto = String($json.response ?? '');\nconst response_id = 'm06-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);\nconst base = { ...ctx, response_id };\n\nconst m = /AGENDAMENTO_CONFIRMADO:\\s*(\\{[\\s\\S]*?\\})/.exec(texto);\nif (!m) {\n  return [{ json: { ...base, agendou: false, mensagem_para_cliente: texto } }];\n}\n\nconst limpo = texto.replace(m[0], '').trim();\nlet p;\ntry {\n  p = JSON.parse(m[1]);\n} catch (e) {\n  // Sinal malformado: degrada para conversa, sem o prefixo tecnico.\n  return [{ json: { ...base, agendou: false,\n    mensagem_para_cliente: limpo || 'Pode confirmar o melhor dia e horario para voce?' } }];\n}\n\nreturn [{ json: { ...base, agendou: true, data: p.data, hora: p.hora,\n  tipo: p.tipo || 'MEETING', duracao_min: p.duracao_min ?? null } }];"
      },
