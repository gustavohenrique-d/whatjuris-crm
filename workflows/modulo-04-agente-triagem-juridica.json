    {
      "parameters": {
        "jsCode": "// Validar e Recalcular Resultado (nao confia na LLM).\nconst raw = $json.output ?? $json.text ?? $json.response ?? '';\nlet result;\ntry {\n  const cleaned = String(raw).trim().replace(/^```json\\s*/i,'').replace(/^```\\s*/i,'').replace(/\\s*```$/i,'').trim();\n  result = JSON.parse(cleaned);\n} catch {\n  return [{ json: { ...$('Set - Preparar Sessão').item.json, agent_status:'error', agent_error:'INVALID_JSON_OUTPUT', allow_send:false } }];\n}\nconst d = {};\nfor (const k of ['nome','area','resumo_caso','urgencia']) {\n  let v = result.dados_extraidos?.[k];\n  if (typeof v === 'string') { v = v.trim(); if (v === '') v = null; } else if (v === undefined) v = null;\n  d[k] = v;\n}\nconst isQualified = typeof d.nome==='string' && d.nome.trim().length>=3 && typeof d.area==='string' && d.area!=='Não identificado' && typeof d.resumo_caso==='string' && d.resumo_caso.trim().length>=10 && ['Baixa','Média','Alta'].includes(d.urgencia);\nconst fase = isQualified ? 'qualificado' : (result.fase_triagem==='desqualificado' ? 'desqualificado' : 'coletando_dados');\nif (!result.mensagem_para_cliente || typeof result.mensagem_para_cliente !== 'string') {\n  return [{ json: { ...$('Set - Preparar Sessão').item.json, agent_status:'error', agent_error:'MISSING_CLIENT_MESSAGE', allow_send:false } }];\n}\nreturn [{ json: { ...$('Set - Preparar Sessão').item.json, dados_extraidos:d, mensagem_para_cliente:result.mensagem_para_cliente, fase_triagem:fase, lead_qualificado:isQualified, agent_status:'success', allow_send:true, result_valid:true } }];"
      },
