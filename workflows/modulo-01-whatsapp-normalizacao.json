    {
      "parameters": {
        "jsCode": "// Saída unificada: monta o contrato final a partir das variáveis\n// normalizadas + o resultado do caminho (message/status/error). Remove\n// respostas brutas de IA, binários e qualquer credencial/URL temporária.\nconst base = $node['Set - Normalizar Variáveis'].json;\nconst cur = $json;\nreturn [{ json: {\n  instance_name: base.instance_name,\n  chat_id: base.chat_id,\n  content: base.content ?? '',\n  from_me: false,\n  message_id: base.message_id,\n  message_type: base.message_type,\n  raw_message_type: base.raw_message_type,\n  message: String(cur.message ?? ''),\n  media_id: base.media_id ?? null,\n  media_mime_type: base.media_mime_type ?? null,\n  received_at: new Date(base.received_at).toISOString(),\n  processing_status: cur.processing_status ?? 'ok',\n  processing_error: cur.processing_error ?? null,\n} }];"
      },
