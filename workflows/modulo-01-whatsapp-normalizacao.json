      "parameters": {
        "jsCode": "// O CRM (whatsapp.js) ja normaliza tudo (texto/audio/imagem) e envia o\n// contrato pronto em body.contract. Aqui so repassamos mensagens recebidas\n// validas ao Modulo 02 - sem refazer normalizacao/midia.\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || item.json;\n  const c = body.contract || body;\n  if (c && c.from_me !== true && c.processing_status === 'ok' && c.message) {\n    out.push({ json: c });\n  }\n}\nreturn out;"
      },
