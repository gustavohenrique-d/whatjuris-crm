{
  "name": "Módulo 05 - Fragmentação e Envio Humanizado WhatsApp",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "modulo-05-envio", "responseMode": "lastNode", "options": {} },
      "id": "n-entrada", "name": "Entrada - Módulo 4 (Webhook Interno)",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-1600, 400], "webhookId": "modulo-05-envio"
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and",
          "conditions": [
            { "leftValue": "={{ ($json.body?.agent_status ?? $json.agent_status) }}", "rightValue": "success", "operator": { "type": "string", "operation": "equals" } },
            { "leftValue": "={{ ($json.body?.allow_send ?? $json.allow_send) }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } },
            { "leftValue": "={{ ($json.body?.mensagem_para_cliente ?? $json.mensagem_para_cliente) }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }
          ] }, "options": {}
      },
      "id": "n-if-autorizada", "name": "IF - Resposta Autorizada?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [-1380, 400]
    },
    {
      "parameters": { "mode": "manual", "assignments": { "assignments": [ { "id": "x1", "name": "send_status", "value": "skipped", "type": "string" } ] }, "options": {} },
      "id": "n-encerrar", "name": "Set - Encerrar Sem Envio",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [-1160, 600]
    },
    {
      "parameters": { "mode": "manual", "includeOtherFields": true, "assignments": { "assignments": [
        { "id": "p1", "name": "instance_name", "value": "={{ $json.body?.instance_name ?? $json.instance_name }}", "type": "string" },
        { "id": "p2", "name": "chat_id", "value": "={{ String($json.body?.chat_id ?? $json.chat_id).replace(/[^0-9]/g,'') }}", "type": "string" },
        { "id": "p3", "name": "message_id", "value": "={{ $json.body?.message_id ?? $json.message_id }}", "type": "string" },
        { "id": "p4", "name": "response_id", "value": "={{ $json.body?.response_id ?? $json.response_id }}", "type": "string" },
        { "id": "p5", "name": "mensagem_para_cliente", "value": "={{ $json.body?.mensagem_para_cliente ?? $json.mensagem_para_cliente }}", "type": "string" },
        { "id": "p6", "name": "expected_control_version", "value": "={{ $json.body?.expected_control_version ?? $json.expected_control_version ?? $json.control_version ?? 0 }}", "type": "number" }
      ] }, "options": {} },
      "id": "n-normalizar", "name": "Set - Normalizar Entrada",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [-1160, 380]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3100/api/conversations/{{ $json.instance_name }}/{{ $json.chat_id }}/control",
        "options": { "timeout": 10000 }
      },
      "id": "n-revalidar", "name": "HTTP - Revalidar Human Takeover",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-940, 380]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and",
          "conditions": [ { "leftValue": "={{ $json.human_takeover }}", "rightValue": "={{ false }}", "operator": { "type": "boolean", "operation": "equals" } } ] }, "options": {}
      },
      "id": "n-if-continua", "name": "IF - Continua Autorizado?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [-720, 380]
    },
    {
      "parameters": { "mode": "manual", "assignments": { "assignments": [ { "id": "d1", "name": "send_status", "value": "discarded", "type": "string" } ] }, "options": {} },
      "id": "n-descartada", "name": "Set - Resposta Descartada",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [-500, 560]
    },
    {
      "parameters": { "mode": "manual", "includeOtherFields": true, "assignments": { "assignments": [
        { "id": "f1", "name": "message_fragments", "value": "={{ (() => { const source = String($('Set - Normalizar Entrada').item.json.mensagem_para_cliente ?? '').replace(/\\r\\n/g,'\\n').trim(); const parts = source.split(/\\n\\s*\\n/).map(p => p.trim()).filter(Boolean); return parts.map((text, index) => ({ text, index, number: index+1, total: parts.length, fragment_id: $('Set - Normalizar Entrada').item.json.response_id + ':' + index })); })() }}", "type": "array" }
      ] }, "options": {} },
      "id": "n-dividir", "name": "Set - Dividir Mensagens",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [-500, 380]
    },
    {
      "parameters": { "fieldToSplitOut": "message_fragments", "options": { "destinationFieldName": "fragment" } },
      "id": "n-split", "name": "Split Out - Fragmentos",
      "type": "n8n-nodes-base.splitOut", "typeVersion": 1, "position": [-280, 380]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "n-loop", "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [-60, 380]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3100/api/conversations/{{ $('Set - Normalizar Entrada').item.json.instance_name }}/{{ $('Set - Normalizar Entrada').item.json.chat_id }}/control",
        "options": { "timeout": 10000 }
      },
      "id": "n-revalidar-frag", "name": "HTTP - Revalidar Antes do Fragmento",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [160, 460]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and",
          "conditions": [ { "leftValue": "={{ $json.human_takeover }}", "rightValue": "={{ false }}", "operator": { "type": "boolean", "operation": "equals" } } ] }, "options": {}
      },
      "id": "n-if-frag-auth", "name": "IF - Fragmento Autorizado?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [380, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3100/api/internal/outbound-fragments/cancel-remaining",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { instance_name: $('Set - Normalizar Entrada').item.json.instance_name, chat_id: $('Set - Normalizar Entrada').item.json.chat_id, response_id: $('Set - Normalizar Entrada').item.json.response_id, from_index: $json.fragment.index, reason: 'human_takeover' } }}",
        "options": { "timeout": 10000 }
      },
      "id": "n-cancel", "name": "HTTP - Cancelar Fragmentos Restantes",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [600, 640]
    },
    {
      "parameters": { "mode": "manual", "assignments": { "assignments": [ { "id": "lc1", "name": "send_status", "value": "cancelled", "type": "string" } ] }, "options": {} },
      "id": "n-loop-cancelado", "name": "Set - Loop Cancelado",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [820, 640]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3100/api/internal/outbound-fragments/reserve",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { instance_name: $('Set - Normalizar Entrada').item.json.instance_name, chat_id: $('Set - Normalizar Entrada').item.json.chat_id, response_id: $('Set - Normalizar Entrada').item.json.response_id, source_message_id: $('Set - Normalizar Entrada').item.json.message_id, fragment_id: $json.fragment.fragment_id, fragment_index: $json.fragment.index, fragment_total: $json.fragment.total, content: $json.fragment.text, expected_control_version: $('Set - Normalizar Entrada').item.json.expected_control_version } }}",
        "options": { "timeout": 10000 }
      },
      "id": "n-reserve", "name": "HTTP - Reservar Fragmento",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [600, 380]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and",
          "conditions": [ { "leftValue": "={{ $json.should_send }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } } ] }, "options": {}
      },
      "id": "n-if-deve-enviar", "name": "IF - Deve Enviar?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [820, 380]
    },
    {
      "parameters": { "mode": "manual", "assignments": { "assignments": [ { "id": "sk1", "name": "fragment_status", "value": "skipped", "type": "string" } ] }, "options": {} },
      "id": "n-pulado", "name": "Set - Fragmento Pulado",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [1040, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/SEU_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', recipient_type: 'individual', to: String($('Set - Normalizar Entrada').item.json.chat_id).replace(/[^0-9]/g,''), type: 'text', text: { preview_url: false, body: $('Loop Over Items').item.json.fragment.text } } }}",
        "options": { "timeout": 15000, "response": { "response": { "neverError": true } } }
      },
      "id": "n-meta", "name": "HTTP - Meta Enviar Texto",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1040, 460],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000,
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_IN_N8N", "name": "Meta WhatsApp Token" } }
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and",
          "conditions": [ { "leftValue": "={{ String($json.messages?.[0]?.id ?? '') }}", "rightValue": "wamid", "operator": { "type": "string", "operation": "startsWith" } } ] }, "options": {}
      },
      "id": "n-if-meta-confirmou", "name": "IF - Meta Confirmou?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1260, 460]
    },
    {
      "parameters": { "mode": "manual", "assignments": { "assignments": [ { "id": "er1", "name": "fragment_status", "value": "failed", "type": "string" } ] }, "options": {} },
      "id": "n-erro-envio", "name": "Set - Erro de Envio",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [1480, 640]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3100/api/internal/outbound-fragments/{{ $('HTTP - Reservar Fragmento').item.json.reservation_id }}/confirm",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { meta_message_id: $('HTTP - Meta Enviar Texto').item.json.messages[0].id, sent_at: $now.toISO(), chat_id: $('Set - Normalizar Entrada').item.json.chat_id, instance_name: $('Set - Normalizar Entrada').item.json.instance_name, content: $('Loop Over Items').item.json.fragment.text, source_message_id: $('Set - Normalizar Entrada').item.json.message_id } }}",
        "options": { "timeout": 10000 }
      },
      "id": "n-confirmar", "name": "HTTP - Confirmar Fragmento no CRM",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1480, 460]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and",
          "conditions": [ { "leftValue": "={{ $('Loop Over Items').item.json.fragment.index }}", "rightValue": "={{ $('Loop Over Items').item.json.fragment.total - 1 }}", "operator": { "type": "number", "operation": "lt" } } ] }, "options": {}
      },
      "id": "n-if-proximo", "name": "IF - Existe Próximo Fragmento?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1700, 460]
    },
    {
      "parameters": { "mode": "manual", "assignments": { "assignments": [
        { "id": "dl1", "name": "typing_delay_seconds", "value": "={{ (() => { const len = String($('Loop Over Items').item.json.fragment.text ?? '').length; const min=2000,max=4000,perChar=30; const jitter=Math.floor(Math.random()*501); return Math.min(max, Math.max(min, len*perChar+jitter)) / 1000; })() }}", "type": "number" }
      ] }, "options": {} },
      "id": "n-delay", "name": "Set - Calcular Delay",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [1920, 360]
    },
    {
      "parameters": { "amount": "={{ $json.typing_delay_seconds }}", "unit": "seconds" },
      "id": "n-wait", "name": "Wait - Simular Digitação",
      "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [2140, 360], "webhookId": "modulo-05-wait"
    },
    {
      "parameters": { "mode": "manual", "assignments": { "assignments": [ { "id": "ec1", "name": "send_status", "value": "sent", "type": "string" } ] }, "options": {} },
      "id": "n-concluido", "name": "Set - Envio Concluído",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [160, 200]
    }
  ],
  "connections": {
    "Entrada - Módulo 4 (Webhook Interno)": { "main": [ [ { "node": "IF - Resposta Autorizada?", "type": "main", "index": 0 } ] ] },
    "IF - Resposta Autorizada?": { "main": [ [ { "node": "Set - Normalizar Entrada", "type": "main", "index": 0 } ], [ { "node": "Set - Encerrar Sem Envio", "type": "main", "index": 0 } ] ] },
    "Set - Normalizar Entrada": { "main": [ [ { "node": "HTTP - Revalidar Human Takeover", "type": "main", "index": 0 } ] ] },
    "HTTP - Revalidar Human Takeover": { "main": [ [ { "node": "IF - Continua Autorizado?", "type": "main", "index": 0 } ] ] },
    "IF - Continua Autorizado?": { "main": [ [ { "node": "Set - Dividir Mensagens", "type": "main", "index": 0 } ], [ { "node": "Set - Resposta Descartada", "type": "main", "index": 0 } ] ] },
    "Set - Dividir Mensagens": { "main": [ [ { "node": "Split Out - Fragmentos", "type": "main", "index": 0 } ] ] },
    "Split Out - Fragmentos": { "main": [ [ { "node": "Loop Over Items", "type": "main", "index": 0 } ] ] },
    "Loop Over Items": { "main": [ [ { "node": "Set - Envio Concluído", "type": "main", "index": 0 } ], [ { "node": "HTTP - Revalidar Antes do Fragmento", "type": "main", "index": 0 } ] ] },
    "HTTP - Revalidar Antes do Fragmento": { "main": [ [ { "node": "IF - Fragmento Autorizado?", "type": "main", "index": 0 } ] ] },
    "IF - Fragmento Autorizado?": { "main": [ [ { "node": "HTTP - Reservar Fragmento", "type": "main", "index": 0 } ], [ { "node": "HTTP - Cancelar Fragmentos Restantes", "type": "main", "index": 0 } ] ] },
    "HTTP - Cancelar Fragmentos Restantes": { "main": [ [ { "node": "Set - Loop Cancelado", "type": "main", "index": 0 } ] ] },
    "HTTP - Reservar Fragmento": { "main": [ [ { "node": "IF - Deve Enviar?", "type": "main", "index": 0 } ] ] },
    "IF - Deve Enviar?": { "main": [ [ { "node": "HTTP - Meta Enviar Texto", "type": "main", "index": 0 } ], [ { "node": "Set - Fragmento Pulado", "type": "main", "index": 0 } ] ] },
    "Set - Fragmento Pulado": { "main": [ [ { "node": "Loop Over Items", "type": "main", "index": 0 } ] ] },
    "HTTP - Meta Enviar Texto": { "main": [ [ { "node": "IF - Meta Confirmou?", "type": "main", "index": 0 } ] ] },
    "IF - Meta Confirmou?": { "main": [ [ { "node": "HTTP - Confirmar Fragmento no CRM", "type": "main", "index": 0 } ], [ { "node": "Set - Erro de Envio", "type": "main", "index": 0 } ] ] },
    "HTTP - Confirmar Fragmento no CRM": { "main": [ [ { "node": "IF - Existe Próximo Fragmento?", "type": "main", "index": 0 } ] ] },
    "IF - Existe Próximo Fragmento?": { "main": [ [ { "node": "Set - Calcular Delay", "type": "main", "index": 0 } ], [ { "node": "Loop Over Items", "type": "main", "index": 0 } ] ] },
    "Set - Calcular Delay": { "main": [ [ { "node": "Wait - Simular Digitação", "type": "main", "index": 0 } ] ] },
    "Wait - Simular Digitação": { "main": [ [ { "node": "Loop Over Items", "type": "main", "index": 0 } ] ] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateId": "whatjuris-modulo-05" },
  "tags": [ { "name": "whatjuris" }, { "name": "modulo-05" } ]
}
